%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Events_ko
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: 0f9addddcd3975348b4e5b7436143f0d, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 944534712320
    m_Localized: "\uC9C0\uB098\uCE5C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944568266752
    m_Localized: "\uC544\uBB34 \uC77C\uB3C4 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461056
    m_Localized: "\uC4F0\uB7EC\uC9C4 \uB098\uBB34"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461057
    m_Localized: "\uAD75\uC740 \uB098\uBB34\uAC00 \uAE38\uC744 \uAC00\uB85C\uB9C9\uACE0
      \uC788\uB2E4. \uB3CC\uC544\uAC00\uAE30\uC5D4 \uAE38\uC774 \uB108\uBB34 \uC881\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461058
    m_Localized: "\uBC00\uACE0 \uC9C0\uB098\uAC04\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461059
    m_Localized: "\uB098\uBB34\uB97C \uBC00\uCE58\uACE0 \uC9C0\uB098\uAC14\uB2E4.
      \uBC94\uD37C\uAC00 \uC870\uAE08 \uAE01\uD614\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461060
    m_Localized: "\uB098\uBB34\uAC00 \uCC28\uCCB4 \uC704\uB85C \uC4F0\uB7EC\uC84C\uB2E4.
      \uBAA8\uB450 \uD06C\uAC8C \uD754\uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461061
    m_Localized: "\uC5F0\uB8CC\uB97C \uC368\uC11C \uC6B0\uD68C\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461062
    m_Localized: "\uBA3C \uAE38\uC744 \uB3CC\uC544 \uBB34\uC0AC\uD788 \uC9C0\uB098\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461063
    m_Localized: "\uB5A0\uB3CC\uC774 \uC0C1\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461064
    m_Localized: "\uAE38\uAC00\uC5D0 \uC9D0\uC218\uB808\uB97C \uC138\uC6B4 \uC0C1\uC778\uC774
      \uC190\uC9D3\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461065
    m_Localized: "\uC2DD\uB7C9\uC744 \uC8FC\uACE0 \uC5F0\uB8CC\uB97C \uBC1B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461066
    m_Localized: "\uC0C1\uC778\uC774 \uC5F0\uB8CC\uD1B5\uC744 \uAC74\uB124\uC8FC\uACE0
      \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461067
    m_Localized: "\uAC70\uB798\uD558\uC9C0 \uC54A\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461068
    m_Localized: "\uC0C1\uC778\uC740 \uC5B4\uAE68\uB97C \uC73C\uC4F1\uD558\uACE0
      \uC218\uB808\uB97C \uB04C\uACE0 \uB5A0\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461069
    m_Localized: "\uC880\uBE44 \uC2B5\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461070
    m_Localized: "\uB3C4\uB85C \uC591\uCABD\uC5D0\uC11C \uC880\uBE44 \uB5BC\uAC00
      \uC3DF\uC544\uC838 \uB098\uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461071
    m_Localized: "\uB9DE\uC11C \uC2F8\uC6B4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461072
    m_Localized: "\uAC04\uC2E0\uD788 \uC4F8\uC5B4\uB0C8\uB2E4. \uBAA8\uB450 \uC0C1\uCC98\uB97C
      \uC785\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461073
    m_Localized: "\uBC00\uB824\uB4DC\uB294 \uC218\uC5D0 \uBC00\uB838\uB2E4. \uCC28\uCCB4\uAE4C\uC9C0
      \uBD80\uC11C\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461074
    m_Localized: "\uC5D4\uC9C4\uC744 \uB05D\uAE4C\uC9C0 \uB3CC\uB824 \uB2EC\uC544\uB09C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461075
    m_Localized: "\uC18D\uB3C4\uB97C \uC62C\uB824 \uBB34\uB9AC\uB97C \uB530\uB3CC\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461076
    m_Localized: "\uB2EC\uC544\uB098\uB294 \uC911\uC5D0 \uBA87 \uB9C8\uB9AC\uAC00
      \uCC28\uC5D0 \uB2EC\uB77C\uBD99\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461077
    m_Localized: "\uC870\uC6A9\uD55C \uD558\uB8E8"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461078
    m_Localized: "\uC624\uB298\uC740 \uC544\uBB34 \uC77C\uB3C4 \uC77C\uC5B4\uB098\uC9C0
      \uC54A\uC558\uB2E4. \uBC14\uB78C \uC18C\uB9AC\uB9CC \uB4E4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461079
    m_Localized: "\uCC28\uB97C \uC815\uBE44\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461080
    m_Localized: "\uB290\uC2A8\uD55C \uB098\uC0AC\uB97C \uC870\uC600\uB2E4. \uC5D4\uC9C4\uC774
      \uD55C\uACB0 \uB0AB\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461081
    m_Localized: "\uAC00\uB9CC\uD788 \uC270\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461082
    m_Localized: "\uC544\uBB34 \uC77C\uB3C4 \uC5C6\uC5C8\uB2E4. \uADF8\uAC8C \uAC00\uC7A5
      \uD070 \uC0AC\uCE58\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461083
    m_Localized: "\uD3D0\uC8FC\uC720\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461084
    m_Localized: "\uB179\uC2A8 \uAC04\uD310 \uC544\uB798 \uC8FC\uC720\uAE30 \uBA87
      \uB300\uAC00 \uC544\uC9C1 \uC11C \uC788\uB2E4. \uBC14\uB2E5\uC5D4 \uD0C0\uC774\uC5B4
      \uC790\uAD6D\uC774 \uC5B4\uC9C0\uB7FD\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461085
    m_Localized: "\uC9C0\uD558 \uD0F1\uD06C\uB97C \uC5F4\uC5B4\uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461086
    m_Localized: "\uBC14\uB2E5\uC5D0 \uACE0\uC778 \uAE30\uB984\uC744 \uD1B5\uC5D0
      \uD37C \uB2F4\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461087
    m_Localized: "\uB69C\uAED1 \uBC11\uC5D0\uC11C \uBB54\uAC00 \uD280\uC5B4\uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461088
    m_Localized: "\uD3B8\uC758\uC810 \uB0C9\uC7A5\uACE0\uB9CC \uB4A4\uC9C4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461089
    m_Localized: "\uBBF8\uC9C0\uADFC\uD55C \uC0DD\uC218 \uD55C \uBCD1\uC774 \uB0A8\uC544
      \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461090
    m_Localized: "\uB9C8\uB978 \uC6B0\uBB3C"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461091
    m_Localized: "\uB9C8\uC744 \uD55C\uAC00\uC6B4\uB370 \uB0A1\uC740 \uC6B0\uBB3C\uC774
      \uC788\uB2E4. \uB3C4\uB974\uB798\uB294 \uC544\uC9C1 \uB3CC\uC544\uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461092
    m_Localized: "\uB85C\uD504\uB97C \uB0B4\uB824 \uD37C \uC62C\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461093
    m_Localized: "\uAE4A\uC740 \uACF3\uC5D0 \uC544\uC9C1 \uBB3C\uC774 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461094
    m_Localized: "\uB85C\uD504\uAC00 \uB04A\uC5B4\uC9C0\uBA70 \uC190\uC744 \uD06C\uAC8C
      \uB2E4\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461095
    m_Localized: "\uB053\uC5EC\uC11C \uAC70\uB978\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461096
    m_Localized: "\uB9D1\uC9C4 \uC54A\uC9C0\uB9CC \uB9C8\uC2E4 \uB9CC\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461097
    m_Localized: "\uAC78\uB7EC\uC9C0\uC9C0 \uC54A\uC740 \uBB54\uAC00\uB97C \uB9C8\uC168\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461098
    m_Localized: "\uD3D0\uB18D\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461099
    m_Localized: "\uBB34\uB108\uC9C4 \uD5DB\uAC04 \uC606\uC5D0 \uD143\uBC2D\uC774
      \uC544\uC9C1 \uD478\uB974\uB2E4. \uC8FC\uC778\uC740 \uBCF4\uC774\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461100
    m_Localized: "\uCC3D\uACE0\uB97C \uB4A4\uC9C4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461101
    m_Localized: "\uBCBD \uC548\uCABD\uC5D0 \uD1B5\uC870\uB9BC \uC0C1\uC790\uAC00
      \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461102
    m_Localized: "\uBC8C\uC9D1\uC744 \uAC74\uB4DC\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461103
    m_Localized: "\uD143\uBC2D\uB9CC \uC0B4\uD540\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461104
    m_Localized: "\uB35C \uC775\uC740 \uCC44\uC18C\uB97C \uBA87 \uAC1C \uB544\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461105
    m_Localized: "\uB2ED\uC7A5 \uC18C\uB9AC\uB97C \uB530\uB77C\uAC04\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461106
    m_Localized: "\uB2EC\uAC40\uC774 \uC544\uC9C1 \uB530\uB73B\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461107
    m_Localized: "\uB180\uB780 \uB2ED\uB5BC\uAC00 \uC55E\uC720\uB9AC \uC704\uB85C
      \uB6F0\uC5B4\uC62C\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461108
    m_Localized: "\uC790\uD310\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461109
    m_Localized: "\uB3C4\uB85C \uD55C\uBCF5\uD310\uC5D0 \uC790\uD310\uAE30\uAC00
      \uCF1C\uC838 \uC788\uB2E4. \uBD88\uC774 \uB4E4\uC5B4\uC628 \uAC74 \uC138\uC0C1\uC5D0\uC11C
      \uC774\uAC83 \uD558\uB098\uBFD0\uC774\uB2E4. '\uB9DB\uC788\uB294 \uB0B4\uC77C\uC744
      \uC751\uC6D0\uD569\uB2C8\uB2E4.'"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461110
    m_Localized: "\uBC1C\uB85C \uCC2C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461111
    m_Localized: "\uCFF5. \uC3DF\uC544\uC84C\uB2E4. \uB0B4\uC77C\uC774 \uB9DB\uC788\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461112
    m_Localized: "\uC790\uD310\uAE30\uAC00 \uC4F0\uB7EC\uC9C0\uBA70 \uBC1C\uC744
      \uB36E\uCCE4\uB2E4. \uAD11\uACE0 \uBB38\uAD6C\uB294 \uC5EC\uC804\uD788 \uBC1D\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461113
    m_Localized: "\uD1B5\uC9F8\uB85C \uC2E3\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461114
    m_Localized: "\uD2B8\uB801\uD06C\uC5D0\uC11C \uC544\uC9C1\uB3C4 \uBD88\uC774
      \uB4E4\uC5B4\uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461115
    m_Localized: "\uBB34\uAC8C\uB97C \uBABB \uC774\uAE34 \uC11C\uC2A4\uD39C\uC158\uC774
      \uBE44\uBA85\uC744 \uC9C8\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461116
    m_Localized: "\uB77C\uB514\uC624 \uD790\uB9C1 \uBC29\uC1A1"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461117
    m_Localized: "\uC9C0\uC9C1\uAC70\uB9AC\uB358 \uB77C\uB514\uC624\uC5D0\uC11C \uBC1D\uC740
      \uBAA9\uC18C\uB9AC\uAC00 \uD758\uB7EC\uB098\uC628\uB2E4. '\uC5EC\uB7EC\uBD84,
      \uC624\uB298\uB3C4 \uC798 \uC0B4\uC544\uB0A8\uC73C\uC168\uB098\uC694?'"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461118
    m_Localized: "\uB05D\uAE4C\uC9C0 \uB4E3\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461119
    m_Localized: "\uC774\uC0C1\uD558\uAC8C \uD798\uC774 \uB0AC\uB2E4. \uBC29\uC1A1\uC740
      \uC815\uC218\uAE30 \uAD11\uACE0\uB85C \uB05D\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461120
    m_Localized: "\uBC29\uC1A1\uC744 \uB530\uB77C \uD558\uB2E4 \uBE44\uC0C1\uC2DD\uB7C9\uC744
      \uAE4C\uBA39\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461121
    m_Localized: "\uC8FC\uD30C\uC218\uB97C \uB3CC\uB824\uBCF8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461122
    m_Localized: "\uC870\uB09C\uC790 \uC704\uCE58 \uBC29\uC1A1\uC774 \uC7A1\uD614\uB2E4.
      \uADF8\uACF3\uC5D4 \uAE30\uB984\uD1B5\uC774 \uB0A8\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461123
    m_Localized: "\uC548\uD14C\uB098\uAC00 \uBD80\uB7EC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944572461124
    m_Localized: "\uB048\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461125
    m_Localized: "\uBC84\uB824\uC9C4 \uC758\uC6D0"
    m_Metadata:
      m_Items: []
  - m_Id: 944572461126
    m_Localized: "\uC2ED\uC790 \uD45C\uC2DC\uAC00 \uBC18\uCBE4 \uC9C0\uC6CC\uC9C4
      \uAC74\uBB3C. \uBB38\uC740 \uC5F4\uB824 \uC788\uACE0 \uC548\uC740 \uC870\uC6A9\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655360
    m_Localized: "\uC57D\uD488 \uCC3D\uACE0\uB97C \uB4A4\uC9C4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655361
    m_Localized: "\uBD95\uB300\uC640 \uD56D\uC0DD\uC81C\uAC00 \uB0A8\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655362
    m_Localized: "\uC720\uD1B5\uAE30\uD55C\uC774 \uD55C\uCC38 \uC9C0\uB09C \uC57D\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655363
    m_Localized: "\uCE68\uB300\uC5D0\uC11C \uD558\uB8FB\uBC24 \uC270\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655364
    m_Localized: "\uC624\uB79C\uB9CC\uC5D0 \uC81C\uB300\uB85C \uC7A4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655365
    m_Localized: "\uD3D0\uCC28\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655366
    m_Localized: "\uCC28\uB4E4\uC774 \uC0B0\uCC98\uB7FC \uC313\uC5EC \uC788\uB2E4.
      \uC4F8 \uB9CC\uD55C \uBD80\uD488\uC774 \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB978\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655367
    m_Localized: "\uBD80\uD488\uC744 \uB72F\uC5B4\uC628\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655368
    m_Localized: "\uB9DE\uB294 \uBD80\uD488\uC774 \uB098\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655369
    m_Localized: "\uB179\uC2A8 \uCCA0\uD310\uC5D0 \uC190\uC744 \uBCA0\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655370
    m_Localized: "\uC5F0\uB8CC\uB97C \uC368\uC11C \uC815\uBE44\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655371
    m_Localized: "\uC5D4\uC9C4 \uC18C\uB9AC\uAC00 \uD55C\uACB0 \uBD80\uB4DC\uB7FD\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655372
    m_Localized: "\uC190\uB300\uC9C0 \uB9D0 \uAC78 \uADF8\uB7AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655373
    m_Localized: "\uBAA8\uB2E5\uBD88"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655374
    m_Localized: "\uBC24\uACF5\uAE30\uAC00 \uCC28\uAC11\uB2E4. \uAE38\uAC00\uC5D0
      \uB9C8\uB978 \uAC00\uC9C0\uAC00 \uB110\uB824 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655375
    m_Localized: "\uBD88\uC744 \uD53C\uC6B4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655376
    m_Localized: "\uBD88\uBE5B \uC544\uB798\uC11C \uBAB8\uC774 \uD480\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655377
    m_Localized: "\uC5F0\uAE30\uB97C \uBCF4\uACE0 \uBB54\uAC00 \uB2E4\uAC00\uC654\uB2E4.
      \uC11C\uB458\uB7EC \uAED0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655378
    m_Localized: "\uBD88 \uC5C6\uC774 \uBC84\uD2F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655379
    m_Localized: "\uCD94\uC6E0\uC9C0\uB9CC \uBC84\uD17C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655380
    m_Localized: "\uD55C\uAE30\uAC00 \uBF1B\uC18D\uAE4C\uC9C0 \uC2A4\uBA84\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655381
    m_Localized: "\uB178\uC0C1\uAC15\uB3C4"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655382
    m_Localized: "\uB3C4\uB85C\uB97C \uB9C9\uC740 \uD2B8\uB7ED \uB4A4\uC5D0\uC11C
      \uCD1D\uAD6C\uAC00 \uC19F\uB294\uB2E4. \uB9D0\uC740 \uC9E7\uB2E4. '\uB2E4 \uB0B4\uB194.'"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655383
    m_Localized: "\uADF8\uB0E5 \uB3CC\uD30C\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655384
    m_Localized: "\uCD1D\uC54C\uC774 \uCC28\uCCB4\uB97C \uAE01\uC5C8\uC9C0\uB9CC
      \uB6AB\uACE0 \uB098\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655385
    m_Localized: "\uBC14\uD034\uC640 \uC720\uB9AC\uAC00 \uB9DE\uC558\uB2E4. \uBAA8\uB450
      \uB2E4\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655386
    m_Localized: "\uC2DD\uB7C9\uC744 \uB0B4\uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655387
    m_Localized: "\uADF8\uB4E4\uC740 \uB9D0\uC5C6\uC774 \uAE38\uC744 \uBE44\uCF30\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655388
    m_Localized: "\uAE30\uB984\uC744 \uBFCC\uB824 \uBD88\uC744 \uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655389
    m_Localized: "\uBD88\uAE38\uC774 \uB3C4\uB85C\uB97C \uAC08\uB790\uB2E4. \uADF8
      \uC0AC\uC774\uC5D0 \uBE60\uC838\uB098\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655390
    m_Localized: "\uBD88\uAE38\uC774 \uCC28 \uCABD\uC73C\uB85C \uBC88\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655391
    m_Localized: "\uBAA8\uB798\uD3ED\uD48D"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655392
    m_Localized: "\uC9C0\uD3C9\uC120\uC774 \uAC08\uC0C9\uC73C\uB85C \uC77C\uC5B4\uC120\uB2E4.
      \uACE7 \uB2E5\uCE5C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655393
    m_Localized: "\uC815\uBA74 \uB3CC\uD30C"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655394
    m_Localized: "\uBAA8\uB798\uAC00 \uCC28\uCCB4\uB97C \uAC08\uC558\uC9C0\uB9CC
      \uC9C0\uB098\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655395
    m_Localized: "\uC2DC\uC57C\uB97C \uC783\uACE0 \uB3C4\uB791\uC5D0 \uCC98\uBC15\uD614\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655396
    m_Localized: "\uCC28\uB97C \uC138\uC6B0\uACE0 \uAE30\uB2E4\uB9B0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655397
    m_Localized: "\uB450 \uC2DC\uAC04 \uB4A4 \uBC14\uB78C\uC774 \uC7A6\uC544\uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655398
    m_Localized: "\uC5F0\uB8CC\uB97C \uC368\uC11C \uC6B0\uD68C\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655399
    m_Localized: "\uBA3C \uAE38\uC774\uC5C8\uC9C0\uB9CC \uC548\uC804\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655400
    m_Localized: "\uC6B0\uD68C\uB85C\uAC00 \uB354 \uD5D8\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655401
    m_Localized: "\uC601\uC6D0\uD55C \uC815\uCCB4"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655402
    m_Localized: "\uC218\uBC31 \uB300\uC758 \uCC28\uAC00 \uC11C \uC788\uB2E4. \uB9E8
      \uC55E \uCC28 \uC6B4\uC804\uC11D\uC758 \uD574\uACE8\uC774 \uC5EC\uC804\uD788
      \uBC29\uD5A5\uC9C0\uC2DC\uB4F1\uC744 \uCF1C\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655403
    m_Localized: "\uD55C \uB300\uC529 \uBC00\uC5B4 \uAE38\uC744 \uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655404
    m_Localized: "\uD2B8\uB801\uD06C\uC5D0\uC11C \uC18C\uD48D \uB3C4\uC2DC\uB77D\uC774
      \uB098\uC654\uB2E4. \uC720\uD1B5\uAE30\uD55C\uC740 \uBB3B\uC9C0 \uC54A\uAE30\uB85C
      \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655405
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uCC28\uAC00 \uC21C\uC21C\uD788 \uBE44\uCF1C\uC8FC\uC9C0
      \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655406
    m_Localized: "\uAC13\uAE38\uB85C \uC6B0\uD68C\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655407
    m_Localized: "\uBC29\uD5A5\uC9C0\uC2DC\uB4F1\uC774 \uC6B0\uB9AC\uC5D0\uAC8C \uC591\uBCF4\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655408
    m_Localized: "\uD391\uD06C. \uAC13\uAE38\uC740 \uAC13\uAE38\uC774 \uC544\uB2C8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655409
    m_Localized: "\uCC28 \uC548\uC744 \uB4A4\uC9C4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655410
    m_Localized: "\uBAA8\uB450\uAC00 \uB0A8\uAE30\uACE0 \uAC04 \uAC04\uC2DD\uC774
      \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655411
    m_Localized: "\uD2B8\uB801\uD06C \uC18D \uBB34\uC5B8\uAC00\uAC00 \uAE68\uC5B4
      \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655412
    m_Localized: "\uB300\uC774\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655413
    m_Localized: "\uC9C0\uD3C9\uC120\uC744 \uB36E\uC740 \uAC83\uC774 \uC0AC\uB78C\uC774
      \uC544\uB2C8\uB77C\uB294 \uAC78 \uAE68\uB2EB\uB294 \uB370 \uBA87 \uCD08\uAC00
      \uAC78\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655414
    m_Localized: "\uC5D4\uC9C4\uC744 \uB05D\uAE4C\uC9C0 \uB3CC\uB824 \uB3CC\uD30C"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655415
    m_Localized: "\uBD80\uB52A\uD788\uB294 \uC18C\uB9AC\uB97C \uC138\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655416
    m_Localized: "\uCC28\uAC00 \uBA87 \uBC88\uC774\uB098 \uB4E4\uB838\uB2E4 \uB0B4\uB824\uC549\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655417
    m_Localized: "\uBA48\uCD94\uACE0 \uC228\uC8FD\uC778\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655418
    m_Localized: "\uBB34\uB9AC\uB294 \uD55C\uCC38 \uB4A4\uC5D0\uC57C \uC9C0\uB098\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655419
    m_Localized: "\uCC3D\uBB38 \uD558\uB098\uAC00 \uAE68\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655420
    m_Localized: "\uC5F0\uB8CC\uD1B5\uC5D0 \uBD88\uC744 \uBD99\uC5EC \uB358\uC9C4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655421
    m_Localized: "\uBD88\uAE38\uC774 \uBC29\uD5A5\uC744 \uD2C0\uC5B4 \uB193\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655422
    m_Localized: "\uBD88\uB625\uC774 \uCC28 \uC704\uB85C \uD280\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655423
    m_Localized: "\uADF8\uB300\uB85C \uBC84\uD2F4\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655424
    m_Localized: "\uCC28\uCCB4\uAC00 \uCC0C\uADF8\uB7EC\uC9C0\uACE0 \uBAA8\uB450
      \uAD6C\uC11D\uC5D0\uC11C \uBAB8\uC744 \uB9D0\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655425
    m_Localized: "\uBB34\uB9AC\uAC00 \uC9C0\uB098\uAC04 \uC790\uB9AC\uC5D0 \uB0A8\uC740
      \uAC74 \uBC18\uCBE4 \uBD80\uC11C\uC9C4 \uCC28\uBFD0\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655426
    m_Localized: "\uD55C\uBC24\uC758 \uB178\uD06C"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655427
    m_Localized: "\uC0C8\uBCBD \uB450 \uC2DC, \uCC28 \uBB38\uC744 \uC815\uC911\uD558\uAC8C
      \uC138 \uBC88 \uB450\uB4DC\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655428
    m_Localized: "\uBB38\uC744 \uC5F0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655429
    m_Localized: "\uB0AF\uC120 \uC5EC\uD589\uC790\uAC00 \uC9D0\uC744 \uB098\uB220\uC8FC\uACE0
      \uB5A0\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655430
    m_Localized: "\uBB38 \uC55E\uC5D0 \uC788\uB358 \uAC74 \uC0AC\uB78C\uC774 \uC544\uB2C8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655431
    m_Localized: "\uC774\uB984\uC744 \uBB3B\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655432
    m_Localized: "\uB178\uD06C\uAC00 \uBA48\uCDC4\uB2E4. \uBC1C\uC18C\uB9AC\uAC00
      \uBA40\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655433
    m_Localized: "\uB300\uB2F5 \uB300\uC2E0 \uC720\uB9AC\uAC00 \uC6B8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655434
    m_Localized: "\uC2DC\uB3D9\uC744 \uAC78\uC5B4 \uCAD3\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655435
    m_Localized: "\uC5D4\uC9C4 \uC18C\uB9AC\uC5D0 \uADF8\uB9BC\uC790\uAC00 \uBB3C\uB7EC\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655436
    m_Localized: "\uB0AF\uC120 \uC0DD\uC874\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655437
    m_Localized: "\uAE38\uAC00\uC5D0 \uC11C\uC11C \uB450 \uC190\uC744 \uB4E0 \uB0A8\uC790\uAC00
      \uC788\uB2E4. '\uBB3C \uD55C \uBAA8\uAE08\uB9CC.'"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655438
    m_Localized: "\uBB3C\uC744 \uB098\uB220\uC900\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655439
    m_Localized: "\uADF8\uB294 \uC228\uACA8\uB454 \uC9D0\uC744 \uB0B4\uB193\uACE0
      \uACE0\uAC1C\uB97C \uC219\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655440
    m_Localized: "\uACE0\uB9D9\uB2E4\uB294 \uB9D0\uACFC \uD568\uAED8 \uC2DD\uB7C9\uC774
      \uC0AC\uB77C\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655441
    m_Localized: "\uAC70\uC808\uD55C\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655442
    m_Localized: "\uADF8\uAC00 \uBA40\uC5B4\uC9C0\uB294 \uAC78 \uBC31\uBBF8\uB7EC\uB85C
      \uBD24\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655443
    m_Localized: "\uAC00\uC9C4 \uAC83\uC744 \uBE7C\uC557\uB294\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 944576655444
    m_Localized: "\uADF8\uB294 \uC800\uD56D\uD558\uC9C0 \uC54A\uC558\uB2E4. \uC544\uBB34\uB3C4
      \uB9D0\uC774 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 944576655445
    m_Localized: "\uADF8\uB294 \uD63C\uC790\uAC00 \uC544\uB2C8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
